# Kopyalayın: cp .env.example .env  — gerçek değerleri yalnızca .env içine yazın, asla commit etmeyin.

# MariaDB/MySQL bağlantısı (uygulama kullanıcısı CREATE DATABASE yetkisine ihtiyaç duymaz)
DATABASE_URL=mysql://KULLANICI:PAROLA@127.0.0.1:3306/makethemenu

# Üretimde zorunlu, en az 32 karakter rastgele değer. Örn: openssl rand -base64 48
SESSION_SECRET=DEGISTIR_EN_AZ_32_KARAKTER

# Ortam: development | production
NODE_ENV=development
PORT=3000

# Herkese açık kök adres (QR kodları, e-posta bağlantıları, sitemap için). Sonunda / olmadan.
PUBLIC_BASE_URL=http://localhost:3000

# Hız sınırları (istek sayısı / pencere). Varsayılanlar: login 20/15dk, kayıt 10/saat,
# doğrulama 5/saat, parola sıfırlama 5/saat. Testlerde yükseltilebilir.
AUTH_LOGIN_MAX=20
AUTH_REGISTER_MAX=10
AUTH_VERIFY_MAX=5
AUTH_FORGOT_MAX=5

# E-posta: şu an yalnızca kuyruk (email_outbox tablosu) aktif. SMTP/sağlayıcı adaptörü
# eklendiğinde buraya kimlik bilgileri gelecek. Gerçek bir değer girilmeden e-posta gönderildiği iddia edilmez.
# EMAIL_PROVIDER=outbox
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# SMTP_FROM=

# Ödeme: PAYMENT_PROVIDER = none | mock | iyzico | paytr | stripe
# (iyzico/paytr/stripe adaptörleri kimlik bilgileri girildiğinde otomatik devreye girer; canlı hesap doğrulaması gerekir)
# PAYMENT_MODE = test | live (live + mock birlikte kullanılamaz; live için ilgili sağlayıcının kimlik bilgileri zorunludur)
# PAYMENT_PROVIDER=none
# PAYMENT_MODE=test
# Webhook imza sırrı: en az 32 karakter. Gerçek değeri .env dosyanıza yazın, buraya yazmayın.
PAYMENT_WEBHOOK_SECRET=

# ── AI menü üretici (opsiyonel) ──
# Ayarlanırsa AI ile menü taslağı gerçek LLM'den üretilir; aksi halde yerel şablonlar kullanılır.
# AI_API_KEY=
# AI_BASE_URL=https://routellm.abacus.ai/v1
# AI_MODEL=gpt-4o-mini

# ── 3D menü ──
# Ürünlere .glb/.gltf bağlantısı eklenir; kota plan tablosundaki max_3d_models ile belirlenir.

# ── SEO / İzleme (Google Analytics, Google Tag Manager, Meta Pixel) ──
# Değer girilmezse ilgili betik hiç yüklenmez. Kimlikleri VITE_ öneki ile .env'ye yazın (gizli değildir, derlemeye gömülür).
# VITE_GA_ID=G-XXXXXXXXXX
# VITE_GTM_ID=GTM-XXXXXXX
# VITE_FB_PIXEL_ID=1234567890123456

# ── Özel alan adı (ek özellik) ──
# DNS doğrulaması TXT kaydıyla yapılır (_mtm-verify.<domain>); TLS platform kenarında otomatik verilir.

# ── Gerçek ödeme sağlayıcıları (canlı hesap gerekir) ──
# PAYMENT_PROVIDER=stripe  →  STRIPE_SECRET_KEY=  STRIPE_WEBHOOK_SECRET=
# PAYMENT_PROVIDER=iyzico  →  IYZICO_API_KEY=  IYZICO_SECRET_KEY=  IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
# PAYMENT_PROVIDER=paytr   →  PAYTR_MERCHANT_ID=  PAYTR_MERCHANT_KEY=  PAYTR_MERCHANT_SALT=
